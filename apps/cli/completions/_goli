#compdef goli
# goli zsh completion
# Generated by scripts/gen-completions.ts — do not edit by hand.
# Install: cp this file to ~/.zsh/completions/_goli && compinit

_goli() {
    local -a commands
    commands=(
        'wakeup:Wake up the 11-agent swarm to perform a task'
        'doctor:Check system requirements and environment health'
        'status:Show health dashboard and active session stats'
        'audit:Verify safety audit log integrity'
        'usage:Show model usage and cost breakdown'
        'commit:Apply pending changes from a session to your host'
        'init:Initialize GOLI.md project memory and build the index'
        'mcp:Manage MCP (Model Context Protocol) servers'
    )

    _arguments -C \
        '--version[Print version and exit]' \
        '-V[Print version and exit]' \
        '--print[Headless mode: run the agent, print the result to stdout, exit]:arg:' \
        '-p[Headless mode: run the agent, print the result to stdout, exit]:arg:' \
        '--debug[Enable debug logging]' \
        '--model[Override the default model for this session]:arg:' \
        '--god[Bypass ALL safety gates (USE WITH EXTREME CAUTION)]' \
        '--auto[Auto-approve Tier 2 (Risky) actions]' \
        '--sandbox[Override sandbox mode: read-only | workspace-write | danger-full-access]:arg:' \
        '--effort[Override reasoning effort: low | high | max]:arg:' \
        '--output-format[Headless output format: text | json | stream-json (default: text)]:arg:' \
        '--spec-mode[Enable spec-driven mode — edit_file/write_file require an approved spec (H13)]' \
        '--diff-review[Enable diff-first review in headless mode (H14)]' \
        '--resume[Resume a previous session by ID (H16)]:arg:' \
        '--branch[Branch a previous session by ID into a new session (H16)]:arg:' \
        '--demo[Launch the TUI with a mock agent (no LLM required). For onboarding, screenshots, and UI testing.]' \
        '--local-llms[Enable local-llms mode: three-axis router across local Ollama workers + cloud tier (sensitivity / complexity / availability)]' \
        '--help[Print this help and exit]' \
        '-h[Print this help and exit]' \
        '*: :->command'

    case $state in
        command)
            _describe 'command' commands
            ;;
    esac
}

_goli "$@"
