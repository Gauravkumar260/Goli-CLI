{
  "name": "goli-cli",
  "version": "0.3.0",
  "private": true,
  "description": "GOLI-CLI — a production-grade, multi-agent software engineering tool. An 8-agent swarm (Orchestrator → Data) for complex, autonomous development tasks. Built as an npm workspaces monorepo with TypeScript + Ink, plus an optional Next.js 16 web console (Goli Studio).",
  "type": "module",
  "license": "MIT",
  "author": "GOLI-CLI Contributors <contrib@goli-cli.dev>",
  "homepage": "https://github.com/goli-cli/goli-cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/goli-cli/goli-cli.git"
  },
  "bugs": {
    "url": "https://github.com/goli-cli/goli-cli/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "tui",
    "multi-agent",
    "swarm",
    "mcp",
    "sandbox",
    "enterprise"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "tsx apps/cli/src/index.ts",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:isolated": "tsx scripts/run-isolated-tests.ts",
    "verify": "npm run build && npm run lint && npm run typecheck && npm test",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "sbom:gen": "syft dir:. -o spdx-json > sbom/spdx.json",
    "sbom:check": "bash scripts/check-sbom.sh",
    "goli": "node apps/cli/dist/index.js",
    "tui": "tsx apps/cli/src/index.ts wakeup --interactive",
    "prepare": "husky || true",
    "bench": "tsx scripts/bench.ts",
    "bench:quick": "tsx scripts/bench.ts --quick",
    "docs:gen": "typedoc --out docs/api/_generated packages/agent-core/src/index.ts --tsconfig packages/agent-core/tsconfig.json",
    "a11y:audit": "tsx scripts/a11y-audit.ts",
    "gen:10k-repo": "tsx scripts/gen-10k-repo.ts",
    "bench:tti": "tsx scripts/tti-bench.ts --10k",
    "test:perf": "vitest run --config vitest.perf.config.ts perf-tests/",
    "test:perf:update": "tsx scripts/update-perf-baselines.ts",
    "test:memory": "node --expose-gc node_modules/vitest/vitest.mjs run --config vitest.perf.config.ts memory-tests/",
    "gen:completions": "tsx scripts/gen-completions.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "studio:dev": "npm run dev --workspace nextjs_tailwind_shadcn_ts",
    "studio:build": "npm run build:web --workspace nextjs_tailwind_shadcn_ts",
    "studio:runtime": "npm run start --workspace nextjs_tailwind_shadcn_ts",
    "studio:db:push": "npm run db:push --workspace nextjs_tailwind_shadcn_ts",
    "studio:db:generate": "npm run db:generate --workspace nextjs_tailwind_shadcn_ts",
    "release:cli": "npm publish -w @goli-cli/cli --provenance --access public"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,toml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.1",
    "eslint-plugin-n": "^17.15.1",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-unicorn": "^56.0.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "ink-testing-library": "4.0.0",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "syncpack": "^15.3.2",
    "tsx": "^4.19.2",
    "turbo": "^2.10.8",
    "typedoc": "^0.27.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
