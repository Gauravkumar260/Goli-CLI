# Goli-CLI API Configuration
#
# Copy this file to `.env` (which is gitignored) and fill in your keys:
#   cp .env.example .env

# Google Gemini API Key (Get one at: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Anthropic Claude API Key (Get one at: https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# OpenAI API Key — the OpenAI provider is blocked in this build by default
OPENAI_API_KEY=

# Ollama Cloud (or omit the key and point GOLI_DEFAULT_MODEL at a local Ollama)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com

# Default Model
GOLI_DEFAULT_MODEL=ollama/gpt-oss:120b-cloud

# Hardware/Performance (Optional)
USE_LOCAL_LLM=false

# Sandbox execution environment: 'docker' or 'local'
GOLI_SANDBOX=local