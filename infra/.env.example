# GOLI-CLI Infrastructure Environment Variables.
# Copy to .env and edit before running `docker compose up`.

# ─── Langfuse ────────────────────────────────────────────────────
# The Langfuse UI requires a salt for session hashing.
LANGFUSE_SALT=changeme-to-a-random-32-char-string

# NextAuth secret for the Langfuse web UI.
NEXTAUTH_SECRET=changeme-to-a-random-32-char-string

# ─── Postgres (Langfuse metadata) ────────────────────────────────
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=langfuse
DATABASE_URL=postgresql://langfuse:changeme-strong-password@postgres:5432/langfuse

# ─── ClickHouse (Langfuse trace storage) ─────────────────────────
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=changeme-strong-password
CLICKHOUSE_URL=http://clickhouse:8123

# ─── LiteLLM Router ──────────────────────────────────────────────
# Master key for the LiteLLM admin API.
LITELLM_MASTER_KEY=changeme-sk-litellm-master-key

# Provider API keys (only open-weight providers — see config.yaml).
# Leave empty if self-hosting via vLLM.
ZAI_API_KEY=
DEEPSEEK_API_KEY=
TOGETHERAI_API_KEY=
MOONSHOT_API_KEY=

# ─── vLLM (self-hosted GLM-5.2) ──────────────────────────────────
# Path to local GLM-5.2 weights (mounted into the vLLM container).
# Leave empty to use Z.AI's hosted API instead of self-hosting.
VLLM_MODEL_PATH=
HUGGING_FACE_HUB_TOKEN=

# ─── GOLI-CLI Agent ──────────────────────────────────────────────
# Default model and effort for the agent.
GOLI_MODEL_MODEL_ID=glm-5.2
GOLI_MODEL_API_KEY=
GOLI_MODEL_BASE_URL=http://litellm:4000/v1

# Observability: export traces to Langfuse.
GOLI_OBSERVABILITY_LANGFUSE_PUBLIC_KEY=pk-lf-...
GOLI_OBSERVABILITY_LANGFUSE_SECRET_KEY=sk-lf-...
GOLI_OBSERVABILITY_LANGFUSE_HOST=http://langfuse:3000
