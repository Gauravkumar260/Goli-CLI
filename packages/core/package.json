{
  "name": "@goli/core",
  "version": "0.2.0-phase2",
  "description": "GOLI-CLI core — the 'Brain': agent loop, tools, safety, context, model providers. Powers the 8-agent swarm (Orchestrator → Data pipeline).",
  "type": "module",
  "license": "MIT",
  "author": "GOLI-CLI Contributors <contrib@goli-cli.dev>",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "zod": "^3.23.8",
    "@goli-cli/approval": "*",
    "@goli-cli/config": "*",
    "@goli-cli/context-engine": "*",
    "@goli-cli/evals": "*",
    "@goli-cli/llm-providers": "*",
    "@goli-cli/memory-engine": "*",
    "@goli-cli/observability": "*",
    "@goli-cli/orchestration": "*",
    "@goli-cli/plugins": "*",
    "@goli-cli/sandbox": "*",
    "@goli-cli/sdk": "*",
    "@goli-cli/shared": "*",
    "@goli-cli/tool-system": "*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
